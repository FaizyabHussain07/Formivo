# Copy to .env.local and fill in values. Never commit real secrets.
# Every variable is optional for local development: the public shell loads with none set.
# Providers that are left blank report "not configured" instead of failing silently.

# Public origin of the app. Must be https:// outside localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# development | preview | production
NEXT_PUBLIC_ENVIRONMENT=development

# Supabase. The anon key is public; the service role key is server-only.
# Auth redirect allow-list must include <app>/auth/callback and localhost variants.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend transactional email (invitations). Without it, the dashboard shows the invite link.
RESEND_API_KEY=
RESEND_FROM_EMAIL=team@formivo.faizyab.me

# Lemon Squeezy billing. Point the webhook at <app>/api/webhooks/lemonsqueezy.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_PRO_VARIANT_ID=
LEMONSQUEEZY_AGENCY_VARIANT_ID=

# Server-only secrets (min 32 chars each). Generate with: openssl rand -hex 32
# Shared secret for scheduled jobs.
CRON_SECRET=
# Peppers for hashing form secrets and client invitation tokens. Required in production.
FORM_SECRET_PEPPER=
INVITATION_TOKEN_PEPPER=
