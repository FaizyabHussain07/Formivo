# Copy to .env.local and fill in values. Never commit real secrets.
# Every variable is optional for local development: the public shell loads with none set.
# Providers that are left blank report "not configured" instead of failing silently.

# Public origin of the app. Must be https:// outside localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# development | preview | production
NEXT_PUBLIC_ENVIRONMENT=development

# Supabase. The anon key is public; the service role key is server-only.

# Auth redirect allow-list must include <app>/auth/callback and localhost variants.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Analytics. All optional: without them the product behaves exactly the same.
# GA4 Measurement ID (Admin > Data streams > your web stream). Format: G-XXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# PostHog project API key (Project settings > Project API key) and ingestion host.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Session replay records screens, so it stays off unless you set this to 1.
NEXT_PUBLIC_POSTHOG_REPLAY=

# Search engine ownership tokens (optional).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Resend transactional email (invitations). Without it, the dashboard shows the invite link.
RESEND_API_KEY=
RESEND_FROM_EMAIL=team@formivo.faizyab.me

# Lemon Squeezy billing. Point the webhook at <app>/api/webhooks/lemonsqueezy.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_PRO_VARIANT_ID=
LEMONSQUEEZY_AGENCY_VARIANT_ID=

# Checkout stays off in production unless this is exactly "true" (set it after store approval).
BILLING_CHECKOUT_ENABLED=

# Admin dashboard (/admin). Credentials live here, never in the codebase.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Server-only secrets (min 32 chars each). Generate with: openssl rand -hex 32
# Shared secret for scheduled jobs.
CRON_SECRET=
# Pepper for hashing client invitation tokens. Required in production.
INVITATION_TOKEN_PEPPER=
